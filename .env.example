PROJECT_NAME=RepoMind
API_VERSION=v1
DATA_DIR=./data
REPOSITORIES_DIR=./data/repos
TEMP_DIR=./data/tmp

MAX_UPLOAD_SIZE_MB=50
MAX_FILE_SIZE_MB=1
MAX_REPOSITORY_FILES=10000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Vite development proxy target (used by frontend/vite.config.js).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Compose publishes the frontend on this port.
REPOMIND_PORT=8080

# LLM setup: mock is the safe local default and does not make network requests.
# For production, set LLM_PROVIDER=openai and provide a key and model below.
# The provider sends prompts to the configured API; never commit .env or secrets.
LLM_PROVIDER=mock
LLM_MOCK_RESPONSE=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
LLM_REQUEST_TIMEOUT=30
LLM_MAX_RETRIES=2
